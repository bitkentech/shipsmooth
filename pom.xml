<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.bitken</groupId>
  <artifactId>shipsmooth</artifactId>
  <version>0.3.7</version>
  <packaging>pom</packaging>

  <modules>
    <module>plugin-node</module>
    <module>plugin-resources</module>
    <module>plugin-skill</module>
    <module>plugin-dist</module>
    <module>plugin-devel</module>
    <module>plugin-tasks-java</module>
  </modules>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <plugin.base.name>shipsmooth</plugin.base.name>
    <plugin.skill.start.basename>start</plugin.skill.start.basename>
    <skip.copy-dist>true</skip.copy-dist>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Pinned to prevent Maven resolving latest from central on direct exec:java@id invocations -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <!-- Canonical compiler version; plugin-tasks-java overrides with its own property -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <!-- Implicit lifecycle plugins — pinned to satisfy requirePluginVersions -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-plugin-versions</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requirePluginVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <build.env>dev</build.env>
        <build.platform>claude</build.platform>
        <skip.copy-dist>false</skip.copy-dist>
        <plugin.name>${plugin.base.name}-dev</plugin.name>
        <plugin.description>Agent coding workflow (dev build)</plugin.description>
        <build.outputDir>${maven.multiModuleProjectDirectory}/build</build.outputDir>
        <plugin.hook.base>node "${CLAUDE_PLUGIN_ROOT}/dist/session-start.js"</plugin.hook.base>
        <shipsmooth.dist.path>\${CLAUDE_PLUGIN_DATA}/dist</shipsmooth.dist.path>
        <shipsmooth.jlink.dir>${maven.multiModuleProjectDirectory}/plugin-tasks-java/target/jlink-image</shipsmooth.jlink.dir>
        <shipsmooth.cli.bin>${XDG_CACHE_HOME:-~/.cache}/shipsmooth-dev/runtime-@project.version@/bin/shipsmooth-tasks</shipsmooth.cli.bin>
        <skill.frontmatter></skill.frontmatter>
        <experimental.enabled>true</experimental.enabled>
      </properties>
    </profile>

    <profile>
      <id>gemini-dev</id>
      <properties>
        <build.env>dev</build.env>
        <build.platform>gemini</build.platform>
        <skip.copy-dist>false</skip.copy-dist>

        <build.outputDir>${maven.multiModuleProjectDirectory}/build-gemini-dev</build.outputDir>

        <plugin.description>Agent coding workflow (dev build)</plugin.description>
        <plugin.hook.base>node "${extensionPath}/dist/session-start.js"</plugin.hook.base>

        <shipsmooth.jlink.dir>${maven.multiModuleProjectDirectory}/plugin-tasks-java/target/jlink-image</shipsmooth.jlink.dir>
        <skill.frontmatter>---
name: start-dev
description: Use when starting any task — applies the shipsmooth agent coding workflow (dev build).
---</skill.frontmatter>
        <experimental.enabled>true</experimental.enabled>
      </properties>
    </profile>

    <profile>
      <id>prod</id>
      <properties>
        <build.env>prod</build.env>
        <build.platform>claude</build.platform>
        <skip.copy-dist>false</skip.copy-dist>
        <plugin.name>${plugin.base.name}</plugin.name>
        <plugin.description>Agent coding workflow with plan-before-implement discipline, TDD, vertical slices, Linear integration, and immutable git-based plan versioning.</plugin.description>
        <build.outputDir>${maven.multiModuleProjectDirectory}/build</build.outputDir>
        <shipsmooth.dist.path>\${CLAUDE_PLUGIN_DATA}/dist</shipsmooth.dist.path>
        <shipsmooth.jlink.dir>/dev/null</shipsmooth.jlink.dir>
        <shipsmooth.cli.bin>${XDG_CACHE_HOME:-~/.cache}/shipsmooth/runtime-@project.version@/bin/shipsmooth-tasks</shipsmooth.cli.bin>
        <plugin.hook.base>node "${CLAUDE_PLUGIN_ROOT}/dist/session-start.js"</plugin.hook.base>
        <skill.frontmatter></skill.frontmatter>
        <experimental.enabled>false</experimental.enabled>
      </properties>
    </profile>
    <profile>
      <id>gemini</id>
      <properties>
        <build.env>prod</build.env>
        <build.platform>gemini</build.platform>
        <skip.copy-dist>false</skip.copy-dist>
        <plugin.description>Agent coding workflow with plan-before-implement discipline, TDD, vertical slices, Linear integration, and immutable git-based plan versioning.</plugin.description>
        <build.outputDir>${maven.multiModuleProjectDirectory}/build-gemini</build.outputDir>
        <shipsmooth.dist.path>~/.cache/shipsmooth/dist</shipsmooth.dist.path>
        <plugin.hook.base>node "${extensionPath}/dist/session-start.js"</plugin.hook.base>
<skill.frontmatter>---
name: start
description: Use when starting any task — applies the shipsmooth agent coding workflow.
---</skill.frontmatter>
        <experimental.enabled>false</experimental.enabled>
      </properties>
    </profile>
  </profiles>

</project>
