<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.bitken</groupId>
        <artifactId>shipsmooth</artifactId>
        <version>0.3.12</version>
    </parent>

    <artifactId>cli</artifactId>

    <properties>
        <picocli.version>4.7.5</picocli.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <jlink.exec.home>/opt/installers/jdk-semeru/jdk-25.0.2+10</jlink.exec.home>
        <jlink.jmods.home>/opt/installers/jdk-semeru/jdk-25.0.2+10</jlink.jmods.home>
        <jlink.jre.home>/opt/installers/jre-semeru/jdk-25.0.2+10-jre</jlink.jre.home>
        <jakarta.xml.bind-api.version>4.0.2</jakarta.xml.bind-api.version>
        <jaxb-runtime.version>4.0.5</jaxb-runtime.version>
        <jackson-databind.version>2.17.2</jackson-databind.version>
        <dagger.version>2.59.2</dagger.version>
        <jakarta.inject-api.version>2.0.1</jakarta.inject-api.version>
        <maven-compiler-plugin.version>3.12.1</maven-compiler-plugin.version>
        <jacoco-maven-plugin.version>0.8.11</jacoco-maven-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.bitken</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-databind.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson-databind.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          DE-RISK SCOPE (plan 68, Task 1): linux jlink image only, proving the two-module
          (io.bitken.ss.core + io.bitken.ss.cli) graph links and runs the version command.
          HARDEN phase will restore the 5 cross-platform builds, SCC launcher, smoke tests,
          and module-info re-injection from the original app/pom.xml jlink profile.
        -->
        <profile>
            <id>jlink</id>
            <properties>
                <!-- core JAR taken from its reactor target dir (no install needed under -am) -->
                <core.jar>${project.basedir}/../core/target/core-${project.version}.jar</core.jar>
                <jlink.runtime.module.path>${project.build.directory}/${project.artifactId}-${project.version}.jar:${core.jar}:${settings.localRepository}/info/picocli/picocli/${picocli.version}/picocli-${picocli.version}.jar:${settings.localRepository}/jakarta/xml/bind/jakarta.xml.bind-api/${jakarta.xml.bind-api.version}/jakarta.xml.bind-api-${jakarta.xml.bind-api.version}.jar:${settings.localRepository}/jakarta/activation/jakarta.activation-api/2.1.3/jakarta.activation-api-2.1.3.jar:${settings.localRepository}/org/glassfish/jaxb/jaxb-runtime/${jaxb-runtime.version}/jaxb-runtime-${jaxb-runtime.version}.jar:${settings.localRepository}/org/glassfish/jaxb/jaxb-core/${jaxb-runtime.version}/jaxb-core-${jaxb-runtime.version}.jar:${settings.localRepository}/org/eclipse/angus/angus-activation/2.0.2/angus-activation-2.0.2.jar:${settings.localRepository}/org/glassfish/jaxb/txw2/${jaxb-runtime.version}/txw2-${jaxb-runtime.version}.jar:${settings.localRepository}/com/sun/istack/istack-commons-runtime/4.1.2/istack-commons-runtime-4.1.2.jar:${settings.localRepository}/com/fasterxml/jackson/core/jackson-databind/${jackson-databind.version}/jackson-databind-${jackson-databind.version}.jar:${settings.localRepository}/com/fasterxml/jackson/core/jackson-core/${jackson-databind.version}/jackson-core-${jackson-databind.version}.jar:${settings.localRepository}/com/fasterxml/jackson/core/jackson-annotations/${jackson-databind.version}/jackson-annotations-${jackson-databind.version}.jar:${settings.localRepository}/com/fasterxml/jackson/datatype/jackson-datatype-jsr310/${jackson-databind.version}/jackson-datatype-jsr310-${jackson-databind.version}.jar:${settings.localRepository}/jakarta/inject/jakarta.inject-api/${jakarta.inject-api.version}/jakarta.inject-api-${jakarta.inject-api.version}.jar</jlink.runtime.module.path>
                <jlink.module.path>${jlink.runtime.module.path}:${jlink.jmods.home}/jmods</jlink.module.path>
            </properties>
            <build>
                <plugins>
                    <!--
                      Dagger is shaded into the CORE jar (see core/pom.xml jlink profile), because
                      DaggerAppComponents is generated into core and references dagger.internal.*
                      at runtime. core must not read cli, so the shaded classes must live in core.
                      The cli jar carries no dagger; here we only link and smoke-test the image.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${maven-antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jlink-build-image</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/jlink-image"/>
                                        <exec executable="${jlink.exec.home}/bin/jlink" failonerror="true">
                                            <arg value="--module-path"/>
                                            <arg value="${jlink.module.path}"/>
                                            <arg value="--add-modules"/>
                                            <arg value="io.bitken.ss.cli,openj9.sharedclasses"/>
                                            <arg value="--launcher"/>
                                            <arg value="shipsmooth=io.bitken.ss.cli/io.bitken.ss.cli.Shipsmooth"/>
                                            <arg value="--no-header-files"/>
                                            <arg value="--no-man-pages"/>
                                            <arg value="--compress"/>
                                            <arg value="zip-9"/>
                                            <arg value="--output"/>
                                            <arg value="${project.build.directory}/jlink-image"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                            <!-- De-risk smoke: prove the linked image runs the version command -->
                            <execution>
                                <id>jlink-smoke-version</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <exec executable="${project.build.directory}/jlink-image/bin/shipsmooth"
                                              failonerror="true">
                                            <arg value="--version"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
