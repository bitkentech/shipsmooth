<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.bitken</groupId>
    <artifactId>shipsmooth</artifactId>
    <version>0.3.13</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>integration-gemini</artifactId>
  <packaging>pom</packaging>

  <profiles>

    <profile>
      <id>gemini</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>

              <!-- Copy and filter gemini-extension.json into build-gemini/ -->
              <execution>
                <id>copy-gemini-manifest</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension</directory>
                      <filtering>true</filtering>
                      <includes>
                        <include>gemini-extension.json</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Copy commands/ into build-gemini/commands/ -->
              <execution>
                <id>copy-commands</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/commands</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension/gemini/commands</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Gemini hooks.json is rendered by Target at the compile phase
                   (node "${extensionPath}/dist/session-start.js"); no copy step needed. -->

              <!-- Copy README.md into build-gemini/ -->
              <execution>
                <id>copy-gemini-readme</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension</directory>
                      <filtering>false</filtering>
                      <includes>
                        <include>README.md</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>gemini-dev</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>copy-gemini-manifest-dev</id>
                <phase>process-resources</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension</directory>
                      <filtering>true</filtering>
                      <includes><include>gemini-extension.json</include></includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <execution>
                <id>copy-commands-dev</id>
                <phase>process-resources</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/commands</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension/gemini-dev/commands</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <execution>
                <id>copy-gemini-readme-dev</id>
                <phase>process-resources</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/main/resources/gemini-extension</directory>
                      <filtering>false</filtering>
                      <includes><include>README.md</include></includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

</project>
