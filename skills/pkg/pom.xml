<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.bitken</groupId>
    <artifactId>skills</artifactId>
    <version>0.3.13</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <!-- renderer module: turns the skills/ JTE content (start/, experimental/, shared/) into rendered output -->
  <artifactId>skills-pkg</artifactId>

  <properties>
    <jte.version>3.1.15</jte.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>gg.jte</groupId>
      <artifactId>jte</artifactId>
      <version>${jte.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- Clean scripts/dist, scripts/dist-test, and scripts/node_modules on mvn clean -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.3.2</version>
        <configuration>
          <filesets>
            <fileset>
              <directory>${project.basedir}/scripts/dist</directory>
            </fileset>
            <fileset>
              <directory>${project.basedir}/scripts/dist-test</directory>
            </fileset>
            <fileset>
              <directory>${project.basedir}/scripts/node_modules</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <!-- 0. npm install + tsc/esbuild: compile TS scripts to scripts/dist/ -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>npm-install</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <workingDirectory>${project.basedir}/scripts</workingDirectory>
              <arguments>
                <argument>-c</argument>
                <argument>[ -d node_modules ] &amp;&amp; [ node_modules -nt package.json ] || npm install --silent</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>tsc-compile</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>bash</executable>
              <workingDirectory>${project.basedir}/scripts</workingDirectory>
              <arguments>
                <argument>-c</argument>
                <argument>[ -d dist ] &amp;&amp; [ dist -nt tasks/session-start.ts ] || npm run build</argument>
              </arguments>
            </configuration>
          </execution>

          <!-- 4. Run Target to render JTE templates into ${build.outputDir} -->
          <execution>
            <id>render-plugin-resources</id>
            <phase>compile</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.bitken.ss.resources.Target</mainClass>
              <systemProperties>
                <systemProperty>
                  <key>build.outputDir</key>
                  <value>${build.outputDir}</value>
                </systemProperty>
                <systemProperty>
                  <key>build.env</key>
                  <value>${build.env}</value>
                </systemProperty>
                <systemProperty>
                  <key>build.platform</key>
                  <value>${build.platform}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.base.name</key>
                  <value>${plugin.base.name}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.skill.start.basename</key>
                  <value>${plugin.skill.start.basename}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.version</key>
                  <value>${project.version}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.description</key>
                  <value>${plugin.description}</value>
                </systemProperty>
                <systemProperty>
                  <key>skill.frontmatter</key>
                  <value>${skill.frontmatter}</value>
                </systemProperty>
                <systemProperty>
                  <key>shipsmooth.jlink.dir</key>
                  <value>${shipsmooth.jlink.dir}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.hook.command</key>
                  <value>${plugin.hook.base}</value>
                </systemProperty>
                <systemProperty>
                  <key>experimental.enabled</key>
                  <value>${experimental.enabled}</value>
                </systemProperty>
                <systemProperty>
                  <key>plugin.repo.name</key>
                  <value>${plugin.repo.name}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 1a. Copy .jte.md sources to target/jte-src/, renaming to .jte -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>rename-jte-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <!--
                Each skill (and shared) folder is registered explicitly below. The .jte.md files
                are copied to target/jte-src/<same-path>/ and renamed to .jte; the path under
                jte-src becomes the JTE template name (e.g. start/SKILL.jte,
                experimental/refine/SKILL.jte, shared/workflow/claude/X.jte).
                To add a new skill: create skills/<name>/SKILL.jte.md and add one <copy> below.
              -->
              <target>
                <!-- start skill -->
                <copy todir="${project.build.directory}/jte-src/start">
                  <fileset dir="${project.basedir}/../start"/>
                  <globmapper from="*.jte.md" to="*.jte"/>
                </copy>
                <!-- experimental skills -->
                <copy todir="${project.build.directory}/jte-src/experimental">
                  <fileset dir="${project.basedir}/../experimental"/>
                  <globmapper from="*.jte.md" to="*.jte"/>
                </copy>
                <!-- shared partials + target snippets -->
                <copy todir="${project.build.directory}/jte-src/shared">
                  <fileset dir="${project.basedir}/../shared"/>
                  <globmapper from="*.jte.md" to="*.jte"/>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 1b. Compile .jte templates to Java bytecode -->
      <plugin>
        <groupId>gg.jte</groupId>
        <artifactId>jte-maven-plugin</artifactId>
        <version>${jte.version}</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <sourceDirectory>${project.build.directory}/jte-src</sourceDirectory>
              <targetDirectory>${project.build.directory}/generated-sources/jte</targetDirectory>
              <contentType>Plain</contentType>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 2. Register generated JTE sources so javac sees them -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/jte</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 3. maven-compiler-plugin (explicit for clarity) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- surefire for JUnit 5 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

    </plugins>
  </build>

</project>
