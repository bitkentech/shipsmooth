<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.bitken</groupId>
    <artifactId>shipsmooth</artifactId>
    <version>0.3.7</version>
  </parent>

  <artifactId>plugin-dist</artifactId>
  <packaging>jar</packaging>

  <properties>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <jdk.semeru.linux-x64>/opt/installers/jdk-semeru/jdk-25.0.2+10</jdk.semeru.linux-x64>
    <jdk.semeru.darwin-x64>/opt/installers/jdk-semeru-mac-x64/Contents/Home</jdk.semeru.darwin-x64>
    <jdk.semeru.darwin-arm64>/opt/installers/jdk-semeru-mac-arm64/Contents/Home</jdk.semeru.darwin-arm64>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.27.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.bitken</groupId>
      <artifactId>plugin-node</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>io.bitken</groupId>
      <artifactId>plugin-resources</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>io.bitken</groupId>
      <artifactId>plugin-skill</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>claude</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>

              <!-- Copy compiled JS scripts into build/scripts/tasks/ -->
              <execution>
                <id>copy-scripts</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/scripts/tasks</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node/dist</directory>
                      <filtering>false</filtering>
                      <excludes>
                        <exclude>**/*.test.js</exclude>
                      </excludes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Copy TS source into build/scripts/tasks/ (used by SessionStart hook to compile at runtime) -->
              <execution>
                <id>copy-ts-source</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/scripts/tasks</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node/src/main/scripts/tasks</directory>
                      <filtering>false</filtering>
                      <excludes>
                        <exclude>**/*.test.ts</exclude>
                      </excludes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Copy compiled JS into build/dist/ (SessionStart hook copies from here to cache) -->
              <execution>
                <id>copy-dist</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/dist</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node/dist</directory>
                      <filtering>false</filtering>
                      <excludes>
                        <exclude>**/*.test.js</exclude>
                      </excludes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Copy package.json into build/ -->
              <execution>
                <id>copy-package-json</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <useDefaultDelimiters>false</useDefaultDelimiters>
                  <delimiters>
                    <delimiter>@</delimiter>
                  </delimiters>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node</directory>
                      <filtering>true</filtering>
                      <includes>
                        <include>package.json</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

            </executions>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>

              <execution>
                <id>package-runtime</id>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.bitken.shipsmooth.dist.PackageRuntime</mainClass>
                  <arguments>
                    <argument>linux-x64</argument>
                    <argument>${jdk.semeru.linux-x64}</argument>
                  </arguments>
                  <systemProperties>
                    <systemProperty>
                      <key>shipsmooth.repo.root</key>
                      <value>${maven.multiModuleProjectDirectory}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>project.version</key>
                      <value>${project.version}</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>

              <execution>
                <id>package-runtime-darwin-x64</id>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.bitken.shipsmooth.dist.PackageRuntime</mainClass>
                  <arguments>
                    <argument>darwin-x64</argument>
                    <argument>${jdk.semeru.darwin-x64}</argument>
                  </arguments>
                  <systemProperties>
                    <systemProperty>
                      <key>shipsmooth.repo.root</key>
                      <value>${maven.multiModuleProjectDirectory}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>project.version</key>
                      <value>${project.version}</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>

              <execution>
                <id>package-runtime-darwin-arm64</id>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.bitken.shipsmooth.dist.PackageRuntime</mainClass>
                  <arguments>
                    <argument>darwin-arm64</argument>
                    <argument>${jdk.semeru.darwin-arm64}</argument>
                  </arguments>
                  <systemProperties>
                    <systemProperty>
                      <key>shipsmooth.repo.root</key>
                      <value>${maven.multiModuleProjectDirectory}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>project.version</key>
                      <value>${project.version}</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>

              <execution>
                <id>publish-release</id>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.bitken.shipsmooth.dist.PublishRelease</mainClass>
                  <arguments>
                    <argument>${shipsmooth.release.version}</argument>
                  </arguments>
                  <systemProperties>
                    <systemProperty>
                      <key>shipsmooth.repo.root</key>
                      <value>${maven.multiModuleProjectDirectory}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>jdk.semeru.linux-x64</key>
                      <value>${jdk.semeru.linux-x64}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>jdk.semeru.darwin-x64</key>
                      <value>${jdk.semeru.darwin-x64}</value>
                    </systemProperty>
                    <systemProperty>
                      <key>jdk.semeru.darwin-arm64</key>
                      <value>${jdk.semeru.darwin-arm64}</value>
                    </systemProperty>
                  </systemProperties>
                </configuration>
              </execution>

            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>

    <!-- dev profile: verify jlink image exists (session-start.js copies it to ~/.cache at runtime) -->
    <profile>
      <id>dev</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>verify-jlink-image-exists</id>
                <phase>process-resources</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <fail message="jlink image not found. Run: mvn -pl plugin-tasks-java -am -Pjlink package">
                      <condition>
                        <not><available file="${maven.multiModuleProjectDirectory}/plugin-tasks-java/target/jlink-image/bin/shipsmooth-tasks"/></not>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>gemini-logic</id>
      <activation>
        <property>
          <name>build.platform</name>
          <value>gemini</value>
        </property>
      </activation>
      <build>
      </build>
    </profile>

    <profile>
      <id>gemini</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>

              <!-- Copy pre-compiled JS into build-gemini/dist/ (hook copies from here to ~/.cache/shipsmooth/dist/) -->
              <execution>
                <id>copy-dist</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}/dist</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node/dist</directory>
                      <filtering>false</filtering>
                      <excludes>
                        <exclude>**/*.test.js</exclude>
                      </excludes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

              <!-- Copy package.json into build-gemini/ (hook uses it for npm install) -->
              <execution>
                <id>copy-package-json</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${build.outputDir}</outputDirectory>
                  <useDefaultDelimiters>false</useDefaultDelimiters>
                  <delimiters>
                    <delimiter>@</delimiter>
                  </delimiters>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/plugin-node</directory>
                      <filtering>true</filtering>
                      <includes>
                        <include>package.json</include>
                    </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>

            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
